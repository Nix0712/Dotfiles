{
  "layer": "bottom",
  "position": "top",
  "height": 38,

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "temperature",
    "cpu",
    "memory",
    "disk#one",
    "disk#two",
    "pulseaudio",
    "network",
    "backlight",
    "battery"
  ],

  // ── Clock ──
  "clock": {
    "format": "{:%a %d %b  %H:%M}",
    "tooltip-format": "{:%A, %B %d %Y}"
  },

  // ── CPU ──
  "cpu": {
    "states": {
      "good": 0,
      "warning": 70,
      "critical": 90
    },
    "interval": 2,
    "format": "  {usage:2}%",
    "tooltip-format": "CPU: {usage}%",
    "on-click": "foot -e btop"
  },

  // ── Temperature ──
  "temperature": {
    "thermal-zone": 3,
    "interval": 2,
    "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
    "critical-threshold": 80,
    "format": "  {temperatureC}°C",
    "format-critical": "  {temperatureC}°C"
  },

  // ── Memory ──
  "memory": {
    "states": {
      "good": 0,
      "warning": 70,
      "critical": 85
    },
    "interval": 5,
    "format": "  {}%",
    "tooltip-format": "Memory: {}% used",
    "on-click": "foot -e btop"
  },

  // ── Disk: root ──
  "disk#one": {
    "states": {
      "good": 0,
      "warning": 70,
      "critical": 95
    },
    "interval": 30,
    "format": "  {percentage_used:2}%",
    "tooltip-format": "/  {used} / {total}  ({percentage_used}%)",
    "path": "/"
  },

  // ── Disk: /data ──
  "disk#two": {
    "states": {
      "good": 0,
      "warning": 70,
      "critical": 95
    },
    "interval": 30,
    "format": "  {percentage_used:2}%",
    "tooltip-format": "/data  {used} / {total}  ({percentage_used}%)",
    "path": "/data"
  },

  // ── Workspaces ──
  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "9": "",
      "10": ""
    }
  },

  // ── Audio ──
  "pulseaudio": {
    "format": "{icon}  {volume}%",
    "format-bluetooth": "  {volume}%",
    "format-muted": "  muted",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "tooltip-format": "{desc}"
  },

  // ── Network ──
  "network": {
    "format-wifi": "  {signalStrength}%",
    "format-ethernet": "  up",
    "format-disconnected": "  off",
    "tooltip-format-wifi": "{essid}  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "interval": 30
  },

  // ── Battery ──
  "battery": {
    "states": {
      "good": 100,
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "  {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time} remaining"
  },

  // ── Backlight ──
  "backlight": {
    "format": "{icon}  {percent}%",
    "format-icons": ["󰃜", "󰃛", "󰃚"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  }
}
